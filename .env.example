# Copy to backend/.env for local development. Every default below is free: SQLite on disk,
# no cloud project, no AI provider. Nothing here activates a paid service.

APP_ENV=local
LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------------------
# sqlite | firestore. Firestore needs requirements-cloud.txt and a GCP project.
DATABASE_BACKEND=sqlite
SQLITE_PATH=data/news.db
# Only read when DATABASE_BACKEND=firestore.
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)

# --- Collection ------------------------------------------------------------------------
COLLECTOR_TIMEOUT_SECONDS=20
COLLECTOR_MAX_ATTEMPTS=3
# Concurrent feed fetches. Kept low deliberately: politeness to publishers.
COLLECTOR_MAX_CONCURRENCY=6
# Minimum seconds between two requests to the same host.
COLLECTOR_MIN_HOST_INTERVAL=1.0
# GAL files per run. Each is roughly 1,800 articles.
GDELT_FILES_PER_RUN=2
# Restrict GDELT to these languages. GAL carries 40+; this product reads French news.
GDELT_LANGUAGES=fr
# Articles kept from one domain per run, so an archive dump cannot take over the list.
GDELT_MAX_PER_DOMAIN=5
# Comma-separated source ids. Empty means every enabled source in the registry.
COLLECTOR_ONLY_SOURCES=

# --- Rights -------------------------------------------------------------------------------
# Asserts that this instance serves ONE PRIVATE HOUSEHOLD and republishes nothing.
#
# A translation is a derivative work, and 28 of the 31 registered publishers have granted no
# permission for one. With this off - the default - exactly one source can be translated.
# With it on, you are asserting the private-use judgement described in
# backend/app/models/rights.py and docs/COPYRIGHT_POLICY.md. It does not override The
# Conversation's explicit CC BY-ND, and the application refuses to start if it is combined
# with APP_ENV=production.
PERSONAL_USE_MODE=false

# --- Translation ----------------------------------------------------------------------------
# "null" or "mymemory". MyMemory is free and needs no API key.
TRANSLATOR=mymemory
TRANSLATE_INTO=zh
# Articles attempted per run. The character budget below is what actually binds.
TRANSLATE_MAX_PER_RUN=40
# Hard character ceiling per run. The provider counts characters, not articles: an average
# headline is 77. MyMemory allows ~5,000 characters/day anonymously, ~50,000 with a contact
# address below. Divide your daily allowance by how often you run this.
TRANSLATE_MAX_CHARACTERS_PER_RUN=600
# Translate the publisher's description too. Costs ~4x the quota per article, so off by
# default: the headline is what this product is for.
TRANSLATE_DESCRIPTIONS=false
# Optional contact address, NOT a credential. MyMemory documents it as the way to raise the
# anonymous daily quota from ~5,000 to ~50,000 characters, and it is sent in the query string.
TRANSLATE_CONTACT_EMAIL=

# --- Summarisation (specified, not implemented) ----------------------------------------------
# "null" generates nothing. A budget of 0 means the summariser never runs.
SUMMARISER=null
SUMMARY_DAILY_BUDGET_CALLS=0

# --- API -----------------------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
