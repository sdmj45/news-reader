# Copy to frontend/.env.local to change how the frontend gets its data.
#
# VITE_DATA_MODE
#   static  Reads public/data/*.json, produced by backend/scripts/export_static.py, and
#           filters in the browser. No server. This is what the deployed site uses, and the
#           default for a production build.
#   api     Talks to the FastAPI backend. The default during `npm run dev`, where
#           vite.config.ts proxies /api to http://127.0.0.1:8000.
VITE_DATA_MODE=

# Only used when VITE_DATA_MODE=api and the backend is not on localhost. Set it to the
# deployed API origin, and add that origin to the backend's API_CORS_ORIGINS or the browser
# will block every request.
VITE_API_BASE_URL=

# Path prefix the site is served from. GitHub Pages project sites live at /<repo>/;
# Cloudflare Pages and custom domains serve from the root, so leave this empty for those.
VITE_BASE=
