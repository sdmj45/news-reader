# Copy to frontend/.env.local for a build that talks to a deployed backend.
#
# Leave this empty for local development: vite.config.ts proxies /api and /health to
# http://127.0.0.1:8000, so the browser sees one origin and CORS never applies.
#
# For Cloudflare Pages, set it to the Cloud Run URL, and add that origin to the backend's
# API_CORS_ORIGINS or every request will be blocked by the browser.
VITE_API_BASE_URL=
