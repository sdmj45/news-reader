# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local data and secrets. The database holds collected article metadata; it is reproducible
# by running the collector and must never be committed.
backend/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Credentials. Nothing resembling a service account key belongs in this repository.
*-service-account*.json
*credentials*.json
gcp-key*.json

# Node
node_modules/
dist/
.vite/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# The exported snapshot is build output: regenerated by scripts/export_static.py on every
# collection run, and published by CI. Committing it would make every run a diff of 400
# articles.
frontend/public/data/
